{
  "manifest_version": 3,
  "name": "ThreadScout",
  "version": "2.1.1",
  "minimum_chrome_version": "116",
  "description": "Find conversations worth joining and develop original tech posts from your X Home timeline.",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "action": {
    "default_title": "Open ThreadScout"
  },
  "background": {
    "service_worker": "worker.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "collector.js",
        "reader.js"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://api.openai.com"
  },
  "optional_host_permissions": [
    "https://api.openai.com/*"
  ]
}
